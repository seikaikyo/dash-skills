<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dash.skills-auto-update</string>

    <!-- ~/.env 帶入 GITGUARDIAN_API_KEY 等選用變數（以前由 .zshrc 載入） -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>[ -f "$HOME/.env" ] &amp;&amp; . "$HOME/.env"; exec /bin/bash "$HOME/Documents/github/dash-skills/scripts/auto-update.sh"</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/dash/Library/Logs/dash-skills-auto-update.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/dash/Library/Logs/dash-skills-auto-update.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/dash/.local/bin:/Users/dash/.pyenv/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/dash</string>
    </dict>
</dict>
</plist>
