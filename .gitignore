# macOS
.DS_Store
.AppleDouble
.LSOverride

# iCloud sync conflict duplicates (e.g. "SKILL 2.md", "README 3.md")
*\ [0-9]*
*\ [0-9]*/

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Backup files
*.backup.*

# Auth state files (private)
*-auth.json
*.auth.json

# Sync state files
.last-*-hash
.last-update
.auto-update.lock/

# Temporary clone directories (used by auto-update.sh)
*-tmp/
external/*-tmp/
external/cisco-skill-scanner/evals/
external/cisco-skill-scanner/skill_scanner/data/

# SkillSpector 安檢報告（public repo 不對外發布第三方 skill 的漏洞判定）
security-reports/

# Python 快取（含本機絕對路徑，不進 public repo）
__pycache__/
*.pyc

# 每日同步的個別 skill 失敗清單（本機狀態，auto-update.sh 與每日巡檢讀取）
.last-sync-failures
